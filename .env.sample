PORT=3000
APP_NAME='YourAppName'
APP_URL=http://localhost:3000
APP_PASSWORD_RESET_URL='http://localhost:3000/reset-password?token=#TOKEN'
APP_ACCOUNT_ACTIVATION_URL='http://localhost:3000/account/activate?token=#TOKEN'
DB_TYPE=postgres
DB_PORT=5432
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
JWT_SECRET=your_jwt_secret
NODE_ENV=development

# mailer
MAILER_HOST=your_mailer_host
MAILER_PORT=your_mailer_port
MAILER_USER=your_mailer_user
MAILER_PASSWORD=your_mailer_password
MAILER_NOREPLY_EMAIL=noreply@yourdomain.com